"""
Project 9: Optimizer Comparison Using a Neural Network (Iris dataset)
Neural network + SGD + Adam implemented from scratch in NumPy.
"""
import json, time
import numpy as np
from sklearn.datasets import load_iris
from sklearn.model_selection import train_test_split
from sklearn.metrics import confusion_matrix, precision_recall_fscore_support

# --------------------------------------------------------------------------
# Network: 4 -> 16 (ReLU) -> 8 (ReLU) -> 3 (Softmax)
# --------------------------------------------------------------------------
LAYERS = [4, 16, 8, 3]


def init_params(rng):
    p = {}
    for i in range(len(LAYERS) - 1):
        fan_in, fan_out = LAYERS[i], LAYERS[i + 1]
        p[f"W{i+1}"] = rng.normal(0, np.sqrt(2.0 / fan_in), (fan_in, fan_out))  # He init
        p[f"b{i+1}"] = np.zeros(fan_out)
    return p


def softmax(z):
    z = z - z.max(axis=1, keepdims=True)
    e = np.exp(z)
    return e / e.sum(axis=1, keepdims=True)


def forward(p, X):
    z1 = X @ p["W1"] + p["b1"]; a1 = np.maximum(0, z1)
    z2 = a1 @ p["W2"] + p["b2"]; a2 = np.maximum(0, z2)
    z3 = a2 @ p["W3"] + p["b3"]; probs = softmax(z3)
    return probs, (X, z1, a1, z2, a2)


def loss_fn(probs, y):
    n = len(y)
    return -np.mean(np.log(probs[np.arange(n), y] + 1e-12))


def backward(p, cache, probs, y):
    X, z1, a1, z2, a2 = cache
    n = len(y)
    dz3 = probs.copy(); dz3[np.arange(n), y] -= 1; dz3 /= n
    g = {}
    g["W3"] = a2.T @ dz3; g["b3"] = dz3.sum(0)
    da2 = dz3 @ p["W3"].T; dz2 = da2 * (z2 > 0)
    g["W2"] = a1.T @ dz2; g["b2"] = dz2.sum(0)
    da1 = dz2 @ p["W2"].T; dz1 = da1 * (z1 > 0)
    g["W1"] = X.T @ dz1; g["b1"] = dz1.sum(0)
    return g


# --------------------------------------------------------------------------
# Optimizers
# --------------------------------------------------------------------------
class SGD:
    def __init__(self, lr, momentum=0.0):
        self.lr, self.m, self.v = lr, momentum, {}

    def step(self, p, g):
        for k in p:
            if self.m > 0:
                self.v[k] = self.m * self.v.get(k, 0) - self.lr * g[k]
                p[k] += self.v[k]
            else:
                p[k] -= self.lr * g[k]


class Adam:
    def __init__(self, lr, b1=0.9, b2=0.999, eps=1e-8):
        self.lr, self.b1, self.b2, self.eps = lr, b1, b2, eps
        self.m, self.v, self.t = {}, {}, 0

    def step(self, p, g):
        self.t += 1
        for k in p:
            self.m[k] = self.b1 * self.m.get(k, 0) + (1 - self.b1) * g[k]
            self.v[k] = self.b2 * self.v.get(k, 0) + (1 - self.b2) * g[k] ** 2
            mh = self.m[k] / (1 - self.b1 ** self.t)
            vh = self.v[k] / (1 - self.b2 ** self.t)
            p[k] -= self.lr * mh / (np.sqrt(vh) + self.eps)


def make_opt(name, lr):
    if name == "SGD": return SGD(lr)
    if name == "SGD+Momentum": return SGD(lr, momentum=0.9)
    if name == "Adam": return Adam(lr)
    raise ValueError(name)


# --------------------------------------------------------------------------
# Data
# --------------------------------------------------------------------------
def get_data(split_seed):
    iris = load_iris()
    X, y = iris.data, iris.target
    Xtr, Xte, ytr, yte = train_test_split(X, y, test_size=0.2, stratify=y, random_state=split_seed)
    mu, sd = Xtr.mean(0), Xtr.std(0)
    return (Xtr - mu) / sd, (Xte - mu) / sd, ytr, yte


def evaluate(p, X, y):
    probs, _ = forward(p, X)
    return loss_fn(probs, y), float(np.mean(probs.argmax(1) == y)), probs.argmax(1)


# --------------------------------------------------------------------------
# Training loop
# --------------------------------------------------------------------------
def train(opt_name, lr, split_seed, init_seed, epochs=100, batch=16, keep_params=False):
    Xtr, Xte, ytr, yte = get_data(split_seed)
    p = init_params(np.random.default_rng(init_seed))
    opt = make_opt(opt_name, lr)
    shuf = np.random.default_rng(1000 + init_seed)
    hist = {k: [] for k in ["train_loss", "train_acc", "test_loss", "test_acc"]}
    t0 = time.perf_counter()
    for ep in range(epochs):
        idx = shuf.permutation(len(ytr))
        for s in range(0, len(idx), batch):
            b = idx[s:s + batch]
            probs, cache = forward(p, Xtr[b])
            g = backward(p, cache, probs, ytr[b])
            opt.step(p, g)
        trl, tra, _ = evaluate(p, Xtr, ytr)
        tel, tea, _ = evaluate(p, Xte, yte)
        hist["train_loss"].append(trl); hist["train_acc"].append(tra)
        hist["test_loss"].append(tel); hist["test_acc"].append(tea)
    hist["time"] = time.perf_counter() - t0
    _, _, pred = evaluate(p, Xte, yte)
    hist["pred"] = pred.tolist(); hist["true"] = yte.tolist()
    if keep_params: hist["params"] = p
    return hist


def first_epoch_below(losses, thr):
    for i, l in enumerate(losses):
        if l <= thr: return i + 1
    return None


# --------------------------------------------------------------------------
# Sanity check: analytic vs numerical gradients
# --------------------------------------------------------------------------
def gradient_check():
    Xtr, _, ytr, _ = get_data(42)
    p = init_params(np.random.default_rng(0))
    X, y = Xtr[:20], ytr[:20]
    probs, cache = forward(p, X)
    g = backward(p, cache, probs, y)
    worst = 0.0
    eps = 1e-5
    rng = np.random.default_rng(1)
    for k in p:
        flat = p[k].ravel()
        for i in rng.choice(flat.size, size=min(6, flat.size), replace=False):
            old = flat[i]
            flat[i] = old + eps; lp = loss_fn(forward(p, X)[0], y)
            flat[i] = old - eps; lm = loss_fn(forward(p, X)[0], y)
            flat[i] = old
            num = (lp - lm) / (2 * eps)
            ana = g[k].ravel()[i]
            rel = abs(num - ana) / max(1e-8, abs(num) + abs(ana))
            worst = max(worst, rel)
    return worst


if __name__ == "__main__":
    out = {}
    out["grad_check_max_rel_err"] = gradient_check()
    print("gradient check max rel err:", out["grad_check_max_rel_err"])

    LR = 0.01
    EPOCHS, BATCH = 100, 16
    out["config"] = dict(lr=LR, epochs=EPOCHS, batch=BATCH, layers=LAYERS)

    # ---- 1. Main (detailed) run: split seed 42, init seed 0
    main = {}
    for name in ["SGD", "Adam", "SGD+Momentum"]:
        main[name] = train(name, LR, 42, 0, EPOCHS, BATCH)
        h = main[name]
        print(f"{name:13s} train_acc={h['train_acc'][-1]:.3f} test_acc={h['test_acc'][-1]:.3f} "
              f"train_loss={h['train_loss'][-1]:.4f} test_loss={h['test_loss'][-1]:.4f}")
    out["main"] = main

    # ---- 2. Robustness: 20 random splits / inits, same LR
    N = 20
    multi = {n: [] for n in ["SGD", "Adam", "SGD+Momentum"]}
    for s in range(N):
        for name in multi:
            multi[name].append(train(name, LR, s, s, EPOCHS, BATCH))
    out["multi"] = multi

    # ---- 3. Learning-rate sensitivity (10 seeds each)
    lrs = [0.001, 0.003, 0.01, 0.03, 0.1, 0.3]
    sens = {n: {} for n in ["SGD", "SGD+Momentum", "Adam"]}
    for name in sens:
        for lr in lrs:
            runs = [train(name, lr, s, s, EPOCHS, BATCH) for s in range(10)]
            sens[name][str(lr)] = dict(
                test_acc=[r["test_acc"][-1] for r in runs],
                train_loss=[r["train_loss"][-1] for r in runs])
    out["sens"] = sens
    out["lrs"] = lrs

    with open("/home/claude/proj9/results.json", "w") as f:
        json.dump(out, f)
    print("saved")
